#!/usr/bin/env bash
# Atajos para manejar el entorno del proyecto. Uso: ./pagos <orden> [argumentos]
set -euo pipefail
cd "$(dirname "$0")"

TOPIC="card-payments"
PARTITIONS=3

dc() { docker compose "$@"; }

# Quita de la salida de errores los avisos de arranque de Hive/Hadoop (SLF4J, log4j,
# NativeCodeLoader...), que no son errores. Los errores de verdad ("Error: ...") se ven.
RUIDO='SLF4J|log4j|NativeCodeLoader|HADOOP_CONF_DIR|package scanning|packages. attribute|logging.apache.org|main INFO|main WARN'
sin_ruido() { grep -vE "$RUIDO" >&2 || true; }        # para la salida de errores
limpio()    { grep -vE "$RUIDO|^[[:space:]]*$" || true; }            # para la salida normal

# Ejecuta un fichero .sql de la carpeta hive/ con beeline (salida en TSV con cabecera).
# Si falla, enseña el motivo real, que Hive solo escribe en su log.
hive_fichero() {
  local estado=0
  dc exec -T hiveserver2 beeline -u jdbc:hive2://localhost:10000/default -n root \
    --silent=true --showHeader=true --outputformat=tsv2 -f "/opt/sql/$1" 2> >(sin_ruido) | limpio \
    || estado=$?
  if [ "$estado" != 0 ]; then
    echo "--- Detalle del error (repetido en modo detallado) ---" >&2
    dc exec -T hiveserver2 beeline -u jdbc:hive2://localhost:10000/default -n root \
      --silent=true --verbose=true -f "/opt/sql/$1" 2>&1 \
      | grep -E "Error|Exception|Caused by|FAILED" | grep -vE "$RUIDO|^\s+at " | head -15 >&2 || true
    echo "--- Log interno de Hive ---" >&2
    dc exec -T hiveserver2 sh -c 'for f in /tmp/*/hive.log /tmp/hive.log /opt/hive/logs/*.log; do [ -f "$f" ] && tail -n 400 "$f"; done' 2>/dev/null \
      | grep -E "Error|Exception|Caused by|FAILED" | grep -vE "$RUIDO" | tail -15 >&2 || true
    return "$estado"
  fi
}

case "${1:-}" in
  up)
    # Construye las imágenes (solo la primera vez) y arranca todos los servicios.
    dc build
    dc up -d
    dc ps
    ;;

  stop)
    # Para los contenedores CONSERVANDO los datos (volúmenes).
    dc --profile pipeline stop
    ;;

  ready)
    # Espera a que HDFS, Kafka y Hive estén listos para trabajar.
    echo '· Esperando HDFS (modo seguro desactivado y 2 DataNodes vivos)...'
    for i in $(seq 1 40); do
      modo=$(dc exec -T namenode hdfs dfsadmin -safemode get 2>/dev/null || true)
      informe=$(dc exec -T namenode hdfs dfsadmin -report 2>/dev/null || true)
      if grep -q 'Safe mode is OFF' <<<"$modo" && grep -q 'Live datanodes (2)' <<<"$informe"; then
        echo '  HDFS listo.'; break
      fi
      [ "$i" = 40 ] && { echo '  HDFS no responde. Revisa: docker compose logs namenode' >&2; exit 1; }
      sleep 3
    done
    echo '· Esperando Kafka...'
    for i in $(seq 1 30); do
      if dc exec -T kafka /opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server kafka:9092 >/dev/null 2>&1; then
        echo '  Kafka listo.'; break
      fi
      [ "$i" = 30 ] && { echo '  Kafka no responde. Revisa: docker compose logs kafka' >&2; exit 1; }
      sleep 3
    done
    echo '· Esperando HiveServer2 (tarda 1-2 minutos la primera vez)...'
    for i in $(seq 1 36); do
      if dc exec -T hiveserver2 beeline -u jdbc:hive2://localhost:10000/default -n root --silent=true -e 'SELECT 1;' >/dev/null 2>&1; then
        echo '  Hive listo.'; exit 0
      fi
      [ "$i" = 36 ] && { echo '  Hive no responde. Revisa: docker compose logs hiveserver2' >&2; exit 1; }
      sleep 5
    done
    ;;

  init)
    # Crea el topic con sus particiones y las carpetas base en HDFS. Se puede repetir sin problema.
    dc exec -T kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:9092 \
      --create --if-not-exists --topic "$TOPIC" --partitions "$PARTITIONS" --replication-factor 1
    dc exec -T kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:9092 --describe --topic "$TOPIC"
    dc exec -T namenode hdfs dfs -mkdir -p /pagos/raw /pagos/ref /pagos/hive
    dc exec -T namenode hdfs dfs -ls /pagos
    ;;

  reset-topic)
    # Borra el topic (y TODOS sus mensajes) y lo vuelve a crear vacío. Útil para repetir una
    # prueba desde cero. No toca HDFS ni Hive.
    dc exec -T kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:9092 \
      --delete --if-exists --topic "$TOPIC"
    for i in $(seq 1 20); do       # el borrado tarda unos segundos en completarse
      if dc exec -T kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:9092 \
           --create --if-not-exists --topic "$TOPIC" --partitions "$PARTITIONS" \
           --replication-factor 1 2>/dev/null; then break; fi
      sleep 2
    done
    dc exec -T kafka /opt/kafka/bin/kafka-get-offsets.sh --bootstrap-server kafka:9092 --topic "$TOPIC"
    ;;

  archivador)
    # Consumidor Kafka → HDFS como servicio.
    case "${2:-}" in
      start) dc --profile pipeline up -d archivador ;;
      stop)  dc --profile pipeline stop archivador ;;     # parada ordenada (SIGTERM)
      kill)  dc --profile pipeline kill archivador ;;     # muerte en seco (SIGKILL)
      logs)  dc --profile pipeline logs -f archivador ;;  # Ctrl-C para dejar de mirar
      *) echo 'Uso: ./pagos archivador start | stop | kill | logs' >&2; exit 2 ;;
    esac
    ;;

  lag)
    # Dónde va leyendo el archivador en cada partición y cuánto le falta (LAG).
    dc exec -T kafka /opt/kafka/bin/kafka-consumer-groups.sh --bootstrap-server kafka:9092 \
      --describe --group archivador-hdfs
    ;;

  raw)
    # Ficheros archivados en HDFS.
    dc exec -T namenode hdfs dfs -ls -R /pagos/raw 2>/dev/null | grep -v '^d' || true
    ;;

  verificar)
    # ¿Está en HDFS todo lo que hay en Kafka?
    dc exec -T app python scripts/verificar_archivo.py
    ;;

  subir-ref)
    # Sube el catálogo de comercios a HDFS (lo usa Hive para la regla R3).
    dc exec -T namenode hdfs dfs -mkdir -p /pagos/ref/comercios
    dc exec -T namenode hdfs dfs -put -f - /pagos/ref/comercios/comercios.csv < simulator/comercios.csv
    dc exec -T namenode hdfs dfs -ls /pagos/ref/comercios
    ;;

  consultas)
    # Lanza P1, P2, P3 y el control, y guarda cada resultado en evidencias/hive/*.tsv
    mkdir -p evidencias/hive
    for q in p1_gasto_dia_categoria p2_franja_horaria p3_tarjetas_sospechosas control; do
      echo "== $q"
      hive_fichero "consultas/$q.sql" | tee "evidencias/hive/$q.tsv"
      echo
    done
    ;;

  check)
    # Prueba de humo: el contenedor Python escribe en HDFS y publica/lee en Kafka.
    dc exec -T app python scripts/smoke_test.py
    ;;

  hdfs)   shift; dc exec -T namenode hdfs "$@" 2> >(sin_ruido) | limpio ;;                         # ./pagos hdfs dfs -ls /pagos
  kafka)  shift; cmd="$1"; shift; dc exec -T kafka "/opt/kafka/bin/$cmd.sh" --bootstrap-server kafka:9092 "$@" ;;
                                                                        # ./pagos kafka kafka-topics --list
  hive)   shift; dc exec -T hiveserver2 beeline -u jdbc:hive2://localhost:10000/default -n root \
            --silent=true --showHeader=true --outputformat=tsv2 -e "$*" 2> >(sin_ruido) | limpio ;;   # ./pagos hive "SHOW TABLES;"
  hivef)  shift; hive_fichero "$1" ;;                                    # ./pagos hivef 01_tablas.sql
  py)     shift; dc exec -T app python "$@" ;;                            # ./pagos py simulator/simulador.py ...

  *)
    cat >&2 <<'EOF'
Uso: ./pagos <orden>
  up       construir y arrancar todo         stop    parar conservando datos
  ready    esperar a que todo esté listo     init    crear topic y carpetas HDFS
  reset-topic  vaciar el topic card-payments (borrar y crear de nuevo)
  archivador start|stop|kill|logs    lag    raw    verificar
  subir-ref    consultas (P1-P3 + control → evidencias/hive)
  check    prueba de humo Python↔HDFS↔Kafka
  hdfs ... | kafka <script> ... | hive "SQL;" | hivef fichero.sql | py script.py ...
EOF
    exit 2 ;;
esac
