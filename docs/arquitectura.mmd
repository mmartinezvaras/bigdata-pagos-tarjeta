flowchart TB
  subgraph ING["Ingesta: del pago al almacén"]
    direction LR
    S["Simulador<br/>semilla + volumen<br/>+ anomalías"] -->|JSON Lines| P["Productor<br/>clave = card_id<br/>acks = all"]
    P --> K[("Kafka<br/>card-payments<br/>3 particiones")]
